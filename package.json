{
  "name": "@undecaf/zbar-wasm",
  "version": "0.11.0",
  "description": "A WebAssembly build of the C/C++ ZBar barcode reader",
  "type": "module",
  "main": "./dist/main.mjs",
  "browser": {
    "./dist/main.cjs": "./dist/index.js",
    "./dist/main.mjs": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "zbar-inlined": "./dist/inlined/main.mjs",
          "default": "./dist/main.mjs"
        },
        "require": {
          "zbar-inlined": "./dist/inlined/main.cjs",
          "default": "./dist/main.cjs"
        }
      },
      "browser": {
        "import": {
          "zbar-inlined": "./dist/inlined/index.mjs",
          "default": "./dist/index.mjs"
        },
        "default": {
          "zbar-inlined": "./dist/inlined/index.js",
          "default": "./dist/index.js"
        }
      },
      "import": {
        "zbar-inlined": "./dist/inlined/main.mjs",
        "default": "./dist/main.mjs"
      },
      "require": {
        "zbar-inlined": "./dist/inlined/main.cjs",
        "default": "./dist/main.cjs"
      },
      "script": {
        "zbar-inlined": "./dist/inlined/index.mjs",
        "default": "./dist/index.mjs"
      },
      "default": {
        "zbar-inlined": "./dist/inlined/index.js",
        "default": "./dist/index.js"
      }
    },
    "./dist/zbar.wasm": "./dist/zbar.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "./dist/*js",
    "./dist/*js.map",
    "./dist/zbar.wasm",
    "./dist/inlined/*js",
    "./dist/inlined/*js.map",
    "./dist/index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/undecaf/zbar-wasm.git"
  },
  "keywords": [
    "zbar",
    "barcode",
    "qrcode",
    "scanner",
    "wasm",
    "webassembly",
    "emscripten"
  ],
  "author": "F. Kasper <fkasper@modus-operandi.at>",
  "license": "LGPL-2.1+",
  "bugs": {
    "url": "https://github.com/undecaf/zbar-wasm/issues"
  },
  "homepage": "https://github.com/undecaf/zbar-wasm#readme",
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "canvas": "^3.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jest": "^30.2.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "testcafe": "^3.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "nan": "^2.18.0"
  }
}
